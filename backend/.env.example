# ============================================================================
# LegalCheck 360: Environment Configuration
# "Smart Packaging. Smarter Compliance."
# ============================================================================

# HTTP Server Port
SERVER_PORT=8080

# SQLite Database File Path
DB_PATH=database/legalcheck360.db

# Upload and Reports Directories
UPLOAD_DIR=backend/uploads
REPORT_DIR=backend/reports
STATIC_DIR=frontend

# Google Gemini API Key (Backend only, never exposed to client)
# If empty or not set, LegalCheck 360 falls back to high-accuracy local regex & keyword OCR extraction
GEMINI_API_KEY=

# Tesseract OCR Executable (If installed on system PATH, e.g. /usr/bin/tesseract or /opt/homebrew/bin/tesseract)
TESSERACT_CMD=tesseract

# Maximum File Upload Size (in bytes: 15MB = 15728640)
MAX_UPLOAD_SIZE=15728640

# Log Level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

