# ============================================================================
# LegalCheck 360: Environment Configuration
# "Smart Packaging. Smarter Compliance."
# ============================================================================

# HTTP Server Port
SERVER_PORT=8080

# SQLite Database File Path
DB_PATH=database/legalcheck360.db

# Upload and Reports Directories
UPLOAD_DIR=backend/uploads
REPORT_DIR=backend/reports
STATIC_DIR=frontend

# Google Gemini API Key (Official google-genai SDK)
# Required for multimodal packaging vision analysis (gemini-2.5-flash)
# If empty or not set, LegalCheck 360 operates in resilient local rules engine mode
GEMINI_API_KEY=

# Preferred Gemini Model (Defaults to gemini-2.5-flash with automated fallbacks)
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin Service Account JSON (Optional, for token verification)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Log Level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
