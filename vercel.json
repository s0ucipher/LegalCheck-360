{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/scans/:id/pdf", "destination": "/api/scan-pdf?id=:id" },
    { "source": "/api/scans/:id", "destination": "/api/scan-detail?id=:id" },
    { "source": "/api/reviews/:id", "destination": "/api/review-scan?id=:id" },
    { "source": "/api/admin/rules/:id/toggle", "destination": "/api/admin-toggle-rule?id=:id" },
    { "source": "/api/admin/rules", "destination": "/api/admin-rules" },
    { "source": "/api/user/claim-scan", "destination": "/api/user/claim-scan" },
    { "source": "/api/user/stats", "destination": "/api/user/stats" },
    { "source": "/api/user/delete-scan", "destination": "/api/user/delete-scan" },
    { "source": "/frontend/(.*)", "destination": "/$1" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/results", "destination": "/results.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/review", "destination": "/review.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
