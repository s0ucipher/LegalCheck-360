{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/upload", "destination": "/frontend/upload.html" },
    { "source": "/results", "destination": "/frontend/results.html" },
    { "source": "/history", "destination": "/frontend/history.html" },
    { "source": "/admin", "destination": "/frontend/admin.html" },
    { "source": "/review", "destination": "/frontend/review.html" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/tests/samples/(.*)", "destination": "/tests/samples/$1" },
    { "source": "/backend/uploads/(.*)", "destination": "/backend/uploads/$1" }
  ]
}

